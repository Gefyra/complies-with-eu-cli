    "url": "https://github.com/Gefyra/complies-with-eu-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gefyra/complies-with-eu-cli.git"
  },
  "license": "Apache-2.0",
  "author": "Gefyra GmbH <js@gefyra.de>",
  "type": "commonjs",
  "bin": {
    "complies-with-eu": "./bin/complies-with-eu.js"
  },
  "files": [
    "bin/",
    "src/",
    "eu-packages.json",
    "tools.json",
    "java-validator-parameter.md",
    "README.md",
    "LICENSE",
